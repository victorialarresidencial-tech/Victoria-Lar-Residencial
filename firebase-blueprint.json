          "enum": ["image", "video"]
        },
        "storagePath": {
          "type": "string",
          "description": "Firebase Storage object path for lifecycle and orphan management",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "description": "Descriptive title or caption of the photograph",
          "maxLength": 150
        },
        "caption": {
          "type": "string",
