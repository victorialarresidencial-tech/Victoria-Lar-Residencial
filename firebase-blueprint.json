          "type": "string",
          "description": "Access tier role: admin or colaborador",
          "enum": ["admin", "colaborador"]
        },
        "modulos": {
          "type": "array",
          "description": "List of granted modules: residentes, colaboradores, landing_page, solicitacoes, usuarios, seguranca"
        },
        "ativo": {
          "type": "boolean",
