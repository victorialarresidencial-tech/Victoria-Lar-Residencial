          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["uid", "email", "nome", "role", "modulos", "ativo", "concedidoEm"]
    },
    "accessRequest": {
      "title": "AccessRequest",
      "description": "Internal staff access request submitted by employee for administration approval",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique request identifier (e.g. req_{uid}_{timestamp})",
          "maxLength": 128
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of requesting user",
          "maxLength": 128
        },
        "nome": {
          "type": "string",
          "description": "Full name of applicant",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "description": "Verified Google email of applicant",
          "maxLength": 160
        },
        "departamento": {
          "type": "string",
          "description": "Requested operational department",
          "maxLength": 100
        },
        "cargo": {
          "type": "string",
          "description": "Job title or position in the institution",
          "maxLength": 100
        },
        "motivo": {
          "type": "string",
          "description": "Justification for access",
          "maxLength": 1000
        },
        "modulosSolicitados": {
          "type": "array",
          "description": "Requested module permissions"
        },
        "status": {
          "type": "string",
          "description": "Review status: pendente, aprovada, rejeitada",
          "enum": ["pendente", "aprovada", "rejeitada"]
        },
        "criadoEm": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "revisadoEm": {
          "type": "string",
          "description": "ISO timestamp of administrative decision"
        },
        "revisadoPorUid": {
          "type": "string",
          "description": "UID of reviewing administrator",
          "maxLength": 128
        },
        "revisadoPorEmail": {
          "type": "string",
          "description": "Email of reviewing administrator",
          "maxLength": 160
        },
        "justificativaRevisao": {
          "type": "string",
          "description": "Feedback or reason for decision",
          "maxLength": 1000
        }
      },
      "required": ["id", "uid", "nome", "email", "motivo", "status", "criadoEm"]
    },
    "accessRequestLock": {
      "title": "AccessRequestLock",
      "description": "Per-user atomic concurrency lock to prevent duplicate pending access requests",
