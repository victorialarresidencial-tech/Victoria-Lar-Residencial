{
  "entities": {
    "admin": {
      "title": "Admin",
      "description": "Administrator account with role-based access control and active status",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Email address of the administrator",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "description": "Permission level: superadmin or admin",
          "enum": ["superadmin", "admin"]
        },
        "active": {
          "type": "boolean",
          "description": "Whether the admin is currently active and authorized"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the creator or system"
        },
        "bootstrapStatus": {
          "type": "string",
          "description": "Status during bootstrap onboarding",
          "enum": ["PENDING_CLAIMS", "COMPLETED"]
        }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "superAdminGuard": {
      "title": "SuperAdminGuard",
      "description": "Concurrency guard to guarantee at least one active superadmin exists",
      "type": "object",
      "properties": {
        "activeSuperAdminCount": {
          "type": "number",
          "description": "Total count of active superadmins"
        },
        "activeSuperAdminUids": {
          "type": "array",
          "description": "UIDs of currently active superadmins"
        },
        "version": {
          "type": "number",
          "description": "Optimistic concurrency version counter"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["activeSuperAdminCount", "version"]
    },
    "bootstrap": {
      "title": "Bootstrap",
      "description": "Initialization status and immutable lockout lock for Victoria Lar",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Lifecycle state of the initialization process",
          "enum": ["UNINITIALIZED", "IN_PROGRESS", "COMPLETED"]
        },
        "bootstrapId": {
          "type": "string",
          "description": "Unique run ID of the bootstrap execution",
          "maxLength": 128
        },
        "superAdminUid": {
          "type": "string",
          "description": "UID of the initial superadmin",
          "maxLength": 128
        },
        "startedAt": {
          "type": "number",
          "description": "Epoch timestamp of start"
        },
        "expiresAt": {
          "type": "number",
          "description": "Epoch timestamp when reservation expires if crashed"
        },
        "completedAt": {
          "type": "number",
          "description": "Epoch timestamp of completion"
        },
        "lockedPermanently": {
          "type": "boolean",
          "description": "Whether the bootstrap process is sealed forever"
        }
      },
      "required": ["status", "lockedPermanently"]
    },
    "authorizedStaffUser": {
      "title": "AuthorizedStaffUser",
