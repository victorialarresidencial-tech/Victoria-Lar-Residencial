{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
