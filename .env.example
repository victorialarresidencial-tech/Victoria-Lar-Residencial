# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURAÇÃO DO PROJETO FIREBASE (SECRETS / VARIÁVEIS DE AMBIENTE)
# ==============================================================================
# Use estas variáveis se você deseja conectar seu próprio projeto Firebase
# (personalizado) em vez da configuração provisionada automaticamente.
#
# Onde encontrar no Firebase Console:
# 1. Acesse https://console.firebase.google.com/
# 2. Selecione o seu projeto
# 3. Vá em "Configurações do Projeto" (ícone de engrenagem) > "Geral" > "Seus aplicativos" (Web)
# 4. No Firestore Database, verifique o ID do banco (o padrão é "(default)")

# VITE_FIREBASE_PROJECT_ID: ID do projeto Firebase (ex: "meu-projeto-lar-residencial")
VITE_FIREBASE_PROJECT_ID="seu-projeto-firebase-id"

# VITE_FIREBASE_DATABASE_ID: ID do banco de dados Cloud Firestore.
# O padrão no Firebase é "(default)". Caso tenha criado um banco nomeado adicional, informe o ID aqui.
VITE_FIREBASE_DATABASE_ID="(default)"

# VITE_FIREBASE_API_KEY: Web API Key do projeto Firebase (gerada pelo Google Cloud/Firebase)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# VITE_FIREBASE_AUTH_DOMAIN: Domínio de autenticação (ex: "seu-projeto-firebase-id.firebaseapp.com")
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto-firebase-id.firebaseapp.com"

# VITE_FIREBASE_STORAGE_BUCKET: Bucket de armazenamento para fotos e documentos
# (ex: "seu-projeto-firebase-id.firebasestorage.app" ou "seu-projeto-firebase-id.appspot.com")
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto-firebase-id.firebasestorage.app"

# VITE_FIREBASE_MESSAGING_SENDER_ID: Número do projeto / ID do remetente FCM
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"

# VITE_FIREBASE_APP_ID: ID do aplicativo web Firebase
# (ex: "1:123456789012:web:abcdef1234567890")
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# VITE_FIREBASE_MEASUREMENT_ID: (Opcional) ID de fluxo do Google Analytics (ex: "G-XXXXXXXXXX")
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Variáveis complementares para o backend Node.js (se preferir definir sem o prefixo VITE_):
FIREBASE_PROJECT_ID="seu-projeto-firebase-id"
FIREBASE_DATABASE_ID="(default)"


# ==============================================================================
# CONFIGURAÇÃO DE ENVIO DE E-MAILS (SMTP / GMAIL / RENDER)
# ==============================================================================

# GMAIL_USER: E-mail remetente oficial da Victoria Lar Residencial.
GMAIL_USER="victorialarresidencial@gmail.com"

# OPÇÃO 1 (Recomendada para Render com Gmail):
# GMAIL_APP_PASSWORD: Senha de app Google (16 caracteres sem espaços ou com espaços).
# Gere em: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# OPÇÃO 2 (Configuração genérica de SMTP ou provedor transacional como SendGrid, Brevo, Resend):
# SMTP_HOST: Servidor SMTP (ex: smtp.gmail.com, smtp.sendgrid.net, smtp-relay.brevo.com)
SMTP_HOST="smtp.gmail.com"

# SMTP_PORT: Porta de conexão SMTP.
# ATENÇÃO NO RENDER:
# - Porta 465 (Recomendada no Render para Gmail): TLS implícito (requer SMTP_SECURE="true").
# - Porta 587: STARTTLS (requer SMTP_SECURE="false"). Se definir secure=true em 587, causará ETIMEDOUT!
# - Porta 25: BLOQUEADA pelo Render para prevenção de spam. Não use porta 25.
SMTP_PORT="465"

# SMTP_SECURE: "true" para porta 465 (TLS implícito); "false" para porta 587 / 2525 (STARTTLS).
SMTP_SECURE="true"

# SMTP_USER: Usuário de autenticação SMTP (para Gmail, mesmo que GMAIL_USER).
SMTP_USER="victorialarresidencial@gmail.com"

# SMTP_PASS: Senha de aplicativo ou chave de API SMTP.
SMTP_PASS="xxxx xxxx xxxx xxxx"

# TEMPOS LIMITE DE REDE NO RENDER (em milissegundos):
# Ajustados para evitar falsos timeouts em contêineres e inicializações frias.
SMTP_CONNECTION_TIMEOUT="10000"
SMTP_GREETING_TIMEOUT="10000"
SMTP_SOCKET_TIMEOUT="15000"
