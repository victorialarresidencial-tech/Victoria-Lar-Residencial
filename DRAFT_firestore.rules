rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Live Database RBAC & Verified Identity:
    // Administrative authorization strictly requires an active document in /admins/{uid}
    // AND a cryptographically verified email from request.auth.
    function isActiveAdmin() {
      return isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // SuperAdmin policy: requires verified active admin AND explicit role == 'superadmin'.
    // No email-only bypass: if active is false or email unverified, access is denied immediately.
    function isSuperAdmin() {
      return isActiveAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Modular Staff Authorization:
    // Requires verified account and active document in /usuariosAutorizados/{uid}
    function isStaffMember() {
      return isVerified() &&
        exists(/databases/$(database)/documents/usuariosAutorizados/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuariosAutorizados/$(request.auth.uid)).data.ativo == true;
    }

    function hasModule(mod) {
      return isStaffMember() &&
        get(/databases/$(database)/documents/usuariosAutorizados/$(request.auth.uid)).data.modulos is list &&
        mod in get(/databases/$(database)/documents/usuariosAutorizados/$(request.auth.uid)).data.modulos;
    }

    function canAccessResidentes() {
      return isActiveAdmin() || hasModule('residentes');
    }

    function canAccessColaboradores() {
      return isActiveAdmin() || hasModule('colaboradores');
    }

    // ---------------------------------------------------------
    // System & Bootstrap Locks (Trusted Server-Side Initiation)
    // ---------------------------------------------------------
    match /system/bootstrap {
      // Sensitive system bootstrap record: accessible only by verified active administrators.
      // Public visitors cannot inspect bootstrap metadata directly.
      allow get: if isActiveAdmin();
      allow list, write: if false;
    }

    function isValidSuperAdminGuard(data) {
      return data.keys().hasAll(['activeSuperAdminCount', 'activeSuperAdminUids', 'version']) &&
        data.keys().hasOnly(['activeSuperAdminCount', 'activeSuperAdminUids', 'version', 'updatedAt']) &&
        data.activeSuperAdminCount is number &&
        data.activeSuperAdminCount >= 1 &&
        data.activeSuperAdminUids is list &&
        data.activeSuperAdminUids.size() >= 1 &&
        data.version is number;
    }

    match /system/superAdminGuard {
      allow get: if isActiveAdmin();
      // Client-side direct writes strictly forbidden: guard is maintained atomically by server transactions
      allow list, write: if false;
    }

    // ---------------------------------------------------------
    // Admin Directory & RBAC
    // ---------------------------------------------------------
    function isValidAdmin(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'active']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'active', 'createdAt', 'updatedAt', 'createdBy', 'bootstrapStatus']) &&
        data.uid == uid &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 160 &&
        data.role in ['superadmin', 'admin'] &&
        data.active is bool;
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (
        (isVerified() && request.auth.uid == uid) || isSuperAdmin()
      );
      allow list: if isActiveAdmin();
      // CRITICAL ARCHITECTURAL SECURITY HARDENING:
      // Client SDK direct creations, updates, and deletions are strictly FORBIDDEN.
      // All administrative accounts, role changes, and deactivations MUST pass through
      // authenticated server-side endpoints with atomic transaction validation.
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // Access Requests (/accessRequests)
    // ---------------------------------------------------------
    match /accessRequests/{requestId} {
      // Access requests are reviewed and managed by active administrators
      allow get: if isValidId(requestId) && isActiveAdmin();
      allow list: if isActiveAdmin();
      // Client direct write blocked: submission, review, and decisions pass through trusted backend endpoints
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // Authorized Staff Users (/usuariosAutorizados)
    // ---------------------------------------------------------
    match /usuariosAutorizados/{uid} {
      // Staff members can read their own authorization record; administrators can inspect all records
      allow get: if isValidId(uid) && (
        (isVerified() && request.auth.uid == uid) || isActiveAdmin()
      );
      allow list: if isActiveAdmin();
      // Client direct mutations blocked: grant, revocation, and module changes are server-managed
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // Access Request Concurrency Locks (/accessRequestLocks)
    // ---------------------------------------------------------
    match /accessRequestLocks/{uid} {
      // Concurrency locking collection reserved strictly for atomic server transactions
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Residentes / Prontuários (/pacientes)
    // ---------------------------------------------------------
    function isValidPaciente(data) {
      return data.keys().hasAll([
        'nomeCompleto', 'dataNascimento', 'cpf', 'sexo',
        'quarto', 'dataAdmissao', 'status', 'grauDependencia',
        'mobilidade', 'tipoSanguineo', 'alergias', 'diagnosticos',
        'medicamentosContinuos', 'dieta', 'responsavel'
      ]) &&
      data.keys().hasOnly([
        'id', 'nomeCompleto', 'nomeSocial', 'dataNascimento', 'cpf', 'rg',
        'sexo', 'estadoCivil', 'quarto', 'dataAdmissao', 'status',
        'grauDependencia', 'mobilidade', 'tipoSanguineo', 'convenioMedico',
        'numeroCarteirinha', 'hospitalReferencia', 'alergias', 'diagnosticos',
        'medicamentosContinuos', 'dieta', 'responsavel', 'observacoesGerais',
        'preferenciasHabitos', 'criadoEm', 'atualizadoEm', 'servidorTimestamp', 'servidorAtualizadoEm'
      ]) &&
      data.nomeCompleto is string && data.nomeCompleto.size() > 0 && data.nomeCompleto.size() <= 150 &&
      data.cpf is string && data.cpf.size() >= 11 && data.cpf.size() <= 20 &&
      data.sexo in ['feminino', 'masculino', 'outro'] &&
      data.status in ['ativo', 'avaliacao', 'temporario', 'alta'] &&
      data.grauDependencia in ['grau1', 'grau2', 'grau3'] &&
      data.mobilidade in ['independente', 'bengala_andador', 'cadeira_rodas', 'acamado'] &&
      data.tipoSanguineo in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-', 'desconhecido'] &&
      data.quarto is string && data.quarto.size() > 0 && data.quarto.size() <= 100 &&
      data.dataNascimento is string && data.dataNascimento.size() <= 30 &&
      data.dataAdmissao is string && data.dataAdmissao.size() <= 30 &&
      data.dieta is string && data.dieta.size() <= 500 &&
      data.alergias is list && data.alergias.size() <= 100 &&
      data.diagnosticos is list && data.diagnosticos.size() <= 100 &&
      data.medicamentosContinuos is list && data.medicamentosContinuos.size() <= 100 &&
      data.responsavel is map &&
      data.responsavel.keys().hasAll(['nome', 'parentesco', 'telefonePrincipal']) &&
      (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
      (!('nomeSocial' in data) || (data.nomeSocial is string && data.nomeSocial.size() <= 150)) &&
      (!('rg' in data) || (data.rg is string && data.rg.size() <= 30)) &&
      (!('estadoCivil' in data) || (data.estadoCivil is string && data.estadoCivil.size() <= 50)) &&
      (!('convenioMedico' in data) || (data.convenioMedico is string && data.convenioMedico.size() <= 100)) &&
      (!('numeroCarteirinha' in data) || (data.numeroCarteirinha is string && data.numeroCarteirinha.size() <= 60)) &&
      (!('hospitalReferencia' in data) || (data.hospitalReferencia is string && data.hospitalReferencia.size() <= 150)) &&
      (!('observacoesGerais' in data) || (data.observacoesGerais is string && data.observacoesGerais.size() <= 5000)) &&
      (!('preferenciasHabitos' in data) || (data.preferenciasHabitos is string && data.preferenciasHabitos.size() <= 5000)) &&
      (!('criadoEm' in data) || (data.criadoEm is string && data.criadoEm.size() <= 50)) &&
      (!('atualizadoEm' in data) || (data.atualizadoEm is string && data.atualizadoEm.size() <= 50));
    }

    match /pacientes/{pacienteId} {
      allow get: if isValidId(pacienteId) && canAccessResidentes();
      allow list: if canAccessResidentes();

      allow create: if isValidId(pacienteId) &&
        canAccessResidentes() &&
        isValidPaciente(incoming());

      allow update: if isValidId(pacienteId) &&
        canAccessResidentes() &&
        isValidPaciente(incoming()) &&
        (!('id' in existing()) || !('id' in incoming()) || incoming().id == existing().id) &&
        (!('criadoEm' in existing()) || incoming().criadoEm == existing().criadoEm);

      // Clinical record deletion is strictly reserved for active administrators
      allow delete: if isValidId(pacienteId) && isActiveAdmin();
    }

    // ---------------------------------------------------------
    // Colaboradores / Funcionários (/funcionarios)
    // ---------------------------------------------------------
    function isValidFuncionario(data) {
      return data.keys().hasAll([
        'nomeCompleto', 'cpf', 'rg', 'dataNascimento', 'sexo', 'estadoCivil',
        'cargo', 'departamento', 'tipoContrato', 'escalaTrabalho', 'dataAdmissao',
        'status', 'matricula', 'celularWhatsApp', 'email', 'cep', 'logradouro',
        'numero', 'bairro', 'cidade', 'estado', 'nomeContatoEmergencia',
        'parentescoEmergencia', 'telefoneEmergencia'
      ]) &&
      data.keys().hasOnly([
        'id', 'nomeCompleto', 'nomeSocial', 'cpf', 'rg', 'orgaoEmissor',
        'dataNascimento', 'idade', 'sexo', 'estadoCivil', 'nacionalidade',
        'naturalidade', 'nomeMae', 'nomePai', 'fotoUrl', 'cargo',
        'cargoPersonalizado', 'departamento', 'registroConselho', 'tipoContrato',
        'escalaTrabalho', 'turno', 'dataAdmissao', 'status', 'matricula',
        'salarioBase', 'celularWhatsApp', 'telefoneFixo', 'email', 'cep',
        'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'estado',
        'nomeContatoEmergencia', 'parentescoEmergencia', 'telefoneEmergencia',
        'pisPasep', 'ctpsNumero', 'ctpsSerie', 'banco', 'agencia', 'conta',
        'tipoChavePix', 'chavePix', 'dataExameAdmissional', 'dataValidadeASO',
        'vacinasEmDia', 'alergiasRestricoes', 'tipoSanguineo', 'qualificacoesCursos',
        'observacoesGerais', 'criadoEm', 'atualizadoEm', 'servidorTimestamp', 'servidorAtualizadoEm'
      ]) &&
      data.nomeCompleto is string && data.nomeCompleto.size() > 0 && data.nomeCompleto.size() <= 150 &&
      data.cpf is string && data.cpf.size() >= 11 && data.cpf.size() <= 20 &&
      data.rg is string && data.rg.size() > 0 && data.rg.size() <= 30 &&
      data.sexo in ['feminino', 'masculino', 'outro'] &&
      data.status in ['ativo', 'ferias', 'afastado', 'desligado'] &&
      data.cargo in [
        'Cuidador(a) de Idosos', 'Enfermeiro(a) Responsável Técnico (RT)',
        'Técnico(a) de Enfermagem', 'Auxiliar de Enfermagem', 'Fisioterapeuta',
        'Nutricionista', 'Terapeuta Ocupacional', 'Médico(a) Geriatra',
        'Psicólogo(a)', 'Fonoaudiólogo(a)', 'Cozinheiro(a)', 'Auxiliar de Cozinha',
        'Auxiliar de Serviços Gerais / Limpeza', 'Encarregado(a) de Lavanderia',
        'Recepcionista / Atendimento', 'Assistente Administrativo / DP',
        'Coordenador(a) Operacional', 'Outro'
      ] &&
      data.departamento in [
        'Cuidados & Enfermagem', 'Equipe Multidisciplinar / Saúde',
        'Cozinha & Nutrição', 'Higienização & Hotelaria',
        'Administração & RH', 'Diretoria & Coordenação'
      ] &&
      data.tipoContrato in [
        'clt_integral', 'clt_parcial', 'pj_prestador',
        'estagio', 'autonomo_plantonista', 'temporario'
      ] &&
      data.escalaTrabalho in [
        '12x36_diurno', '12x36_noturno', '6x1', '5x2',
        'plantonista', 'horista', 'outro'
      ] &&
      data.email is string && data.email.size() > 3 && data.email.size() <= 160 &&
      data.matricula is string && data.matricula.size() > 0 && data.matricula.size() <= 50 &&
      data.celularWhatsApp is string && data.celularWhatsApp.size() >= 8 && data.celularWhatsApp.size() <= 30 &&
      data.cep is string && data.cep.size() <= 20 &&
      data.cidade is string && data.cidade.size() <= 100 &&
      data.estado is string && data.estado.size() <= 10 &&
      data.dataNascimento is string && data.dataNascimento.size() <= 30 &&
      data.dataAdmissao is string && data.dataAdmissao.size() <= 30 &&
      data.logradouro is string && data.logradouro.size() <= 200 &&
      data.numero is string && data.numero.size() <= 30 &&
      data.bairro is string && data.bairro.size() <= 100 &&
      data.nomeContatoEmergencia is string && data.nomeContatoEmergencia.size() <= 150 &&
      data.parentescoEmergencia is string && data.parentescoEmergencia.size() <= 60 &&
      data.telefoneEmergencia is string && data.telefoneEmergencia.size() >= 8 && data.telefoneEmergencia.size() <= 30 &&
      (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
      (!('nomeSocial' in data) || (data.nomeSocial is string && data.nomeSocial.size() <= 150)) &&
      (!('orgaoEmissor' in data) || (data.orgaoEmissor is string && data.orgaoEmissor.size() <= 50)) &&
      (!('idade' in data) || (data.idade is number)) &&
      (!('nacionalidade' in data) || (data.nacionalidade is string && data.nacionalidade.size() <= 60)) &&
      (!('naturalidade' in data) || (data.naturalidade is string && data.naturalidade.size() <= 60)) &&
      (!('nomeMae' in data) || (data.nomeMae is string && data.nomeMae.size() <= 150)) &&
      (!('nomePai' in data) || (data.nomePai is string && data.nomePai.size() <= 150)) &&
      (!('fotoUrl' in data) || (data.fotoUrl is string && data.fotoUrl.size() <= 2000)) &&
      (!('cargoPersonalizado' in data) || (data.cargoPersonalizado is string && data.cargoPersonalizado.size() <= 150)) &&
      (!('registroConselho' in data) || (data.registroConselho is string && data.registroConselho.size() <= 100)) &&
      (!('turno' in data) || (data.turno in ['Manhã', 'Tarde', 'Noite', 'Plantão 12h', 'Comercial'])) &&
      (!('salarioBase' in data) || (data.salarioBase is string && data.salarioBase.size() <= 50)) &&
      (!('telefoneFixo' in data) || (data.telefoneFixo is string && data.telefoneFixo.size() <= 30)) &&
      (!('complemento' in data) || (data.complemento is string && data.complemento.size() <= 100)) &&
      (!('pisPasep' in data) || (data.pisPasep is string && data.pisPasep.size() <= 30)) &&
      (!('ctpsNumero' in data) || (data.ctpsNumero is string && data.ctpsNumero.size() <= 30)) &&
      (!('ctpsSerie' in data) || (data.ctpsSerie is string && data.ctpsSerie.size() <= 30)) &&
      (!('banco' in data) || (data.banco is string && data.banco.size() <= 100)) &&
      (!('agencia' in data) || (data.agencia is string && data.agencia.size() <= 30)) &&
      (!('conta' in data) || (data.conta is string && data.conta.size() <= 40)) &&
      (!('tipoChavePix' in data) || (data.tipoChavePix in ['cpf', 'email', 'telefone', 'aleatoria'])) &&
      (!('chavePix' in data) || (data.chavePix is string && data.chavePix.size() <= 160)) &&
      (!('dataExameAdmissional' in data) || (data.dataExameAdmissional is string && data.dataExameAdmissional.size() <= 30)) &&
      (!('dataValidadeASO' in data) || (data.dataValidadeASO is string && data.dataValidadeASO.size() <= 30)) &&
      (!('vacinasEmDia' in data) || (data.vacinasEmDia is list && data.vacinasEmDia.size() <= 50)) &&
      (!('alergiasRestricoes' in data) || (data.alergiasRestricoes is string && data.alergiasRestricoes.size() <= 2000)) &&
      (!('tipoSanguineo' in data) || (data.tipoSanguineo in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-', 'Desconhecido'])) &&
      (!('qualificacoesCursos' in data) || (data.qualificacoesCursos is list && data.qualificacoesCursos.size() <= 100)) &&
      (!('observacoesGerais' in data) || (data.observacoesGerais is string && data.observacoesGerais.size() <= 5000)) &&
      (!('criadoEm' in data) || (data.criadoEm is string && data.criadoEm.size() <= 50)) &&
      (!('atualizadoEm' in data) || (data.atualizadoEm is string && data.atualizadoEm.size() <= 50));
    }

    match /funcionarios/{funcionarioId} {
      allow get: if isValidId(funcionarioId) && canAccessColaboradores();
      allow list: if canAccessColaboradores();

      allow create: if isValidId(funcionarioId) &&
        canAccessColaboradores() &&
        isValidFuncionario(incoming());

      allow update: if isValidId(funcionarioId) &&
        canAccessColaboradores() &&
        isValidFuncionario(incoming()) &&
        (!('id' in existing()) || !('id' in incoming()) || incoming().id == existing().id) &&
        (!('criadoEm' in existing()) || incoming().criadoEm == existing().criadoEm);

      // Employee record deletion is strictly reserved for active administrators
      allow delete: if isValidId(funcionarioId) && isActiveAdmin();
    }

    // ---------------------------------------------------------
    // Services Collection (Published public, drafts admin-only)
    // ---------------------------------------------------------
    function isValidService(data) {
      return data.keys().hasAll(['id', 'title', 'summary', 'status', 'order']) &&
        data.keys().hasOnly(['id', 'title', 'summary', 'description', 'icon', 'category', 'order', 'status', 'highlight', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.summary is string && data.summary.size() > 0 && data.summary.size() <= 300 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
        (!('icon' in data) || (data.icon is string && data.icon.size() <= 64)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('highlight' in data) || data.highlight is bool) &&
        data.status in ['draft', 'published'] &&
        data.order is number;
    }

    match /services/{serviceId} {
      // RULES ARE NOT FILTERS:
      allow get: if isValidId(serviceId) && (
        resource.data.status == 'published' || isActiveAdmin()
      );
      allow list: if resource.data.status == 'published' || isActiveAdmin();

      allow create: if isValidId(serviceId) &&
        isActiveAdmin() &&
        isValidService(incoming()) &&
        incoming().id == serviceId;

      allow update: if isValidId(serviceId) &&
        isActiveAdmin() &&
        isValidService(incoming()) &&
        incoming().id == existing().id;

      allow delete: if isValidId(serviceId) && isActiveAdmin();
    }

    // ---------------------------------------------------------
    // Institutional Content (Public institutional keys only; Admin editable)
    // ---------------------------------------------------------
    function isPublicContentKey(key) {
      return key in ['hero', 'about', 'values', 'owner_1', 'owner_2', 'scheduling'] ||
        key.matches('^album_[a-zA-Z0-9_\\-]+$');
    }

    function isValidContent(data, key) {
      return data.keys().hasAll(['key', 'title']) &&
        data.keys().hasOnly(['key', 'title', 'subtitle', 'body', 'phone', 'whatsapp', 'email', 'address', 'visitingHours', 'imageUrl', 'imageCaption', 'role', 'quote', 'tag', 'meetingLink', 'availableHours', 'meetingDuration', 'whatsappMessage', 'emailSubject', 'emailInstructions', 'updatedAt', 'updatedBy']) &&
        data.key == key &&
        data.key is string && data.key.size() <= 64 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 500)) &&
        (!('body' in data) || (data.body is string && data.body.size() <= 250000)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 30)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('visitingHours' in data) || (data.visitingHours is string && data.visitingHours.size() <= 200)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000)) &&
        (!('imageCaption' in data) || (data.imageCaption is string && data.imageCaption.size() <= 200)) &&
        (!('role' in data) || (data.role is string && data.role.size() <= 200)) &&
        (!('quote' in data) || (data.quote is string && data.quote.size() <= 2000)) &&
        (!('tag' in data) || (data.tag is string && data.tag.size() <= 200)) &&
        (!('meetingLink' in data) || (data.meetingLink is string && data.meetingLink.size() <= 500)) &&
        (!('availableHours' in data) || (data.availableHours is string && data.availableHours.size() <= 500)) &&
        (!('meetingDuration' in data) || (data.meetingDuration is string && data.meetingDuration.size() <= 100)) &&
        (!('whatsappMessage' in data) || (data.whatsappMessage is string && data.whatsappMessage.size() <= 1000)) &&
        (!('emailSubject' in data) || (data.emailSubject is string && data.emailSubject.size() <= 200)) &&
        (!('emailInstructions' in data) || (data.emailInstructions is string && data.emailInstructions.size() <= 2000));
    }

    match /content/{contentKey} {
      // Public visitors can only access public institutional documents.
      // Drafts, internal notes, and administrative configurations remain private.
      allow get: if isValidId(contentKey) && (isPublicContentKey(contentKey) || isActiveAdmin());
      allow list: if isActiveAdmin();
      allow create, update: if isValidId(contentKey) &&
        isActiveAdmin() &&
        isValidContent(incoming(), contentKey);
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // Contact Leads (PII Guard: No direct public read, Admin only)
    // ---------------------------------------------------------
    function isValidLead(data, leadId) {
      return data.keys().hasAll(['id', 'name', 'phone', 'status']) &&
        data.keys().hasOnly(['id', 'name', 'phone', 'email', 'relationship', 'serviceInterest', 'message', 'status', 'type', 'notes', 'meetingLink', 'createdAt', 'scheduledDate', 'scheduledTime']) &&
        data.id == leadId &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 30 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('relationship' in data) || (data.relationship is string && data.relationship.size() <= 60)) &&
        (!('serviceInterest' in data) || (data.serviceInterest is string && data.serviceInterest.size() <= 100)) &&
        (!('message' in data) || (data.message is string && data.message.size() <= 2000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('meetingLink' in data) || (data.meetingLink is string && data.meetingLink.size() <= 500)) &&
        data.status in ['unread', 'read', 'contacted', 'scheduled', 'archived'] &&
        (!('type' in data) || (data.type in ['form', 'meeting', 'whatsapp'])) &&
        (!('scheduledDate' in data) || (data.scheduledDate is string && data.scheduledDate.size() <= 20)) &&
        (!('scheduledTime' in data) || (data.scheduledTime is string && data.scheduledTime.size() <= 20)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidPublicLead(data, leadId) {
      return isValidLead(data, leadId) &&
        !('notes' in data) &&
        !('meetingLink' in data) &&
        data.status == 'unread';
    }

    match /leads/{leadId} {
      allow get, list: if isValidId(leadId) && isActiveAdmin();
      // Public creation validates fields strictly: no notes, no custom meeting links, unread status only
      // Admin creation also strictly validates all allowed lead fields
      allow create: if isValidId(leadId) && (
        isValidPublicLead(incoming(), leadId) ||
        (isActiveAdmin() && isValidLead(incoming(), leadId))
      );
      // Admin update strictly enforces schema, preserves immutable ID and creation timestamp
      allow update: if isValidId(leadId) &&
        isActiveAdmin() &&
        isValidLead(incoming(), leadId) &&
        incoming().id == existing().id &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isValidId(leadId) && isSuperAdmin();
    }

    // ---------------------------------------------------------
    // Audit Logs (Immutable, Server-Authorized Only)
    // ---------------------------------------------------------
    function isValidAuditLog(data, logId) {
      return data.keys().hasAll(['id', 'action', 'performedByUid', 'timestamp']) &&
        data.keys().hasOnly(['id', 'action', 'performedByUid', 'performedByEmail', 'targetResource', 'details', 'timestamp']) &&
        data.id == logId &&
        data.id is string && data.id.size() <= 128 &&
        data.action is string && data.action.size() <= 80 &&
        data.performedByUid == request.auth.uid &&
        data.timestamp is string && data.timestamp.size() <= 50;
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isActiveAdmin();
      allow list: if isActiveAdmin();
      // Client-side forgery blocked: only trusted server authority can write audit events
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // Structure Albums & Photos (Facility Highlights)
    // ---------------------------------------------------------
    function isValidAlbum(data, albumId) {
      return data.keys().hasAll(['id', 'title', 'topicKey']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'topicKey', 'coverImageUrl', 'order', 'status', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.id == albumId &&
        data.id is string && data.id.size() <= 64 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.topicKey is string && data.topicKey.size() <= 64 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 2000)) &&
        (!('order' in data) || data.order is number) &&
        (!('status' in data) || (data.status in ['draft', 'published']));
    }

    function isParentAlbumPublished(albumId) {
      return exists(/databases/$(database)/documents/albums/$(albumId)) &&
        get(/databases/$(database)/documents/albums/$(albumId)).data.status == 'published';
    }

    function isValidPhoto(data, photoId, albumId) {
      return data.keys().hasAll(['id', 'albumId', 'url', 'altText', 'order', 'published']) &&
        data.keys().hasOnly(['id', 'albumId', 'url', 'storagePath', 'title', 'caption', 'altText', 'mediaType', 'order', 'published', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.id == photoId &&
        data.id is string && data.id.size() <= 128 &&
        data.albumId == albumId &&
        data.url is string && data.url.size() <= 2000 &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 500)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 150)) &&
        (!('caption' in data) || (data.caption is string && data.caption.size() <= 500)) &&
        data.altText is string && data.altText.size() <= 200 &&
        (!('mediaType' in data) || (data.mediaType in ['image', 'video'])) &&
        data.order is number &&
        data.published is bool;
    }

    match /albums/{albumId} {
      // Visitors can only read published albums; active admins can read all
      allow get: if isValidId(albumId) && (
        resource.data.status == 'published' || isActiveAdmin()
      );
      allow list: if resource.data.status == 'published' || isActiveAdmin();

      allow create: if isValidId(albumId) &&
        isActiveAdmin() &&
        isValidAlbum(incoming(), albumId);

      allow update: if isValidId(albumId) &&
        isActiveAdmin() &&
        isValidAlbum(incoming(), albumId) &&
        incoming().id == existing().id;

      allow delete: if isValidId(albumId) && isActiveAdmin();

      match /photos/{photoId} {
        // Public visitors can only view published photos when the parent album exists AND is published.
        // Active admins can view all photos including drafts.
        allow get: if isValidId(photoId) && (
          (resource.data.published == true && isParentAlbumPublished(albumId)) ||
          isActiveAdmin()
        );
        allow list: if (
          (resource.data.published == true && isParentAlbumPublished(albumId)) ||
          isActiveAdmin()
        );

        allow create: if isValidId(photoId) && isValidId(albumId) &&
          isActiveAdmin() &&
          isValidPhoto(incoming(), photoId, albumId);

        allow update: if isValidId(photoId) && isValidId(albumId) &&
          isActiveAdmin() &&
          isValidPhoto(incoming(), photoId, albumId) &&
          incoming().id == existing().id;

        allow delete: if isValidId(photoId) && isActiveAdmin();
      }
    }
  }
}
